[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://features/gameplay/board_view.gd" id="1_board"]

[node name="BoardView" type="PanelContainer"]
custom_minimum_size = Vector2(280, 0)
mouse_filter = 0
theme_type_variation = &"BoardPanel"
script = ExtResource("1_board")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="BoardName" type="Label" parent="Content/Header"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "РЕЧ 1"

[node name="HeaderSpacer" type="Control" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="AttemptStatus" type="Label" parent="Content/Header"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "ПОКУШАЈ 1 / 6"

[node name="Cells" type="GridContainer" parent="Content"]
layout_mode = 2
columns = 5
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 4
